{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/services/:slug/index.html",
      "destination": "/services/:slug",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.gospelco.com.ng" }],
      "destination": "https://gospelco.com.ng/$1",
      "permanent": true
    }
  ]
}
