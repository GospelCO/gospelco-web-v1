{
  "redirects": [
    {
      "source": "/services/:slug/index.html",
      "destination": "/services/:slug",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/services/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/cart/(.*)",
      "destination": "/index.html"
    }
  ]
}